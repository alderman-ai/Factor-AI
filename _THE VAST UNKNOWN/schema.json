{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cartridge schema v1 — the operator's thing-schema, ruled 2026-08-18 (Open Questions Q2). A thing is a file or folder in the vault; Visible says whether the operator has discovered it yet. Strict: nothing untyped gets in.",
  "type": "object",
  "properties": {
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": { "type": "string", "minLength": 1 },
          "Visible": { "enum": ["Yes", "No"] },
          "First Appearance": { "type": "string", "pattern": "^Run-\\d{3}$" },
          "Version": { "type": "integer", "minimum": 1 }
        },
        "required": ["Name", "Visible", "First Appearance", "Version"],
        "additionalProperties": false
      }
    }
  },
  "required": ["objects"],
  "additionalProperties": false
}
